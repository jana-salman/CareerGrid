# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Model for generating workplace assignments (defaults to GEMINI_MODEL). In live tests the lite
# models produced starter code too thin to pass the quality checks; see README "Workplace
# Assignment Quality" for measured results before choosing.
GEMINI_SCENARIO_MODEL=gemini-3.5-flash
# Optional reasoning effort for that model: minimal, low, medium, or high (default: model default).
GEMINI_SCENARIO_THINKING=
# Bounds for one task generation; after these, CareerGrid uses a built-in assignment.
SCENARIO_GENERATION_BUDGET_SECONDS=240
SCENARIO_GENERATION_MAX_ATTEMPTS=4
# "single" (one call per draft, default) or "staged" (a task specification first, then the project).
SCENARIO_GENERATION_PIPELINE=single
# Every generated candidate (accepted or rejected, with its validation reasons) is kept for inspection
# under instance/generation_candidates/ unless this is 0. SCENARIO_CANDIDATE_DIR overrides the folder.
SCENARIO_CANDIDATE_ARCHIVE=1
SCENARIO_CANDIDATE_DIR=
# After a failed assignment generation, launches use the built-in assignment for this long
# (doubling per consecutive failure, capped at 6 hours) before Gemini is tried again.
ASSIGNMENT_RETRY_COOLDOWN_SECONDS=900

# Firebase / Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Flask
SECRET_KEY=your_flask_secret_key_here
CAREERGRID_ENV=development
FLASK_DEBUG=false

# Adzuna Job API
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Live job listings
# Two-letter country code used by default. Adzuna supports: at au be br ca ch de es
# fr gb in it mx nl nz pl sg us za. Adzuna does NOT cover Lebanon (lb).
JOB_SEARCH_COUNTRY=us
# Optional city/region filter inside that country (Adzuna "where").
JOB_SEARCH_LOCATION=
# Optional: Jooble partner API key, used only for Lebanon (lb). Request one at
# https://jooble.org/api/about. Without it, Lebanon shows an honest "unavailable" state.
JOOBLE_API_KEY=
